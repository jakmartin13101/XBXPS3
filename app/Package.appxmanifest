<?xml version="1.0" encoding="utf-8"?>
<!--
  XBXPS3 package manifest.

  Capabilities follow the shipped XBSX2 port (PCSX2 for Xbox Dev Mode):
    codeGeneration         JIT recompilers (RPCS3 PPU/SPU LLVM and ASMJIT)
    runFullTrust           with codeGeneration, what lets the desktop-compiled core use
                           VirtualAlloc2/MapViewOfFile3 placeholders and RWX pages in Dev Mode
                           (xbxps3_probe.txt reports whether this holds on your console)
    removableStorage, broadFileSystemAccess
                           games, firmware and packages on E:\XBXPS3
    internetClient, internetClientServer, privateNetworkClientServer
                           RPCN and PS3 networking
  Publisher must match the subject of the signing certificate (scripts/package.ps1).
  After installing, set the app type to Game in Dev Home, or it only gets ~1 GB of RAM.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="XBXPS3"
    Publisher="CN=XBXPS3 Dev"
    Version="0.1.0.0" />

  <Properties>
    <DisplayName>XBXPS3</DisplayName>
    <PublisherDisplayName>XBXPS3</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="XBXPS3.App">
      <uap:VisualElements
        DisplayName="XBXPS3"
        Description="RPCS3 PlayStation 3 emulator for Xbox Series X|S (Developer Mode)"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        BackgroundColor="#101418">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="XBXPS3" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#101418" />
      </uap:VisualElements>
      <Extensions>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="xbxps3" />
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
    <Capability Name="codeGeneration" />
    <uap:Capability Name="removableStorage" />
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="broadFileSystemAccess" />
  </Capabilities>
</Package>
