From f09093da916a9e00245ead729f520b206c3610b5 Mon Sep 17 00:00:00 2001
From: XBXPS3 <xbxps3@localhost>
Date: Tue, 13 Oct 2026 11:30:47 +0000
Subject: [PATCH 1/6] cmake: add RPCS3_UWP core-only build mode for the Xbox
 frontend

---
 3rdparty/CMakeLists.txt |  2 +-
 CMakeLists.txt          | 16 ++++++++++++++++
 rpcs3/CMakeLists.txt    |  6 +++---
 3 files changed, 20 insertions(+), 4 deletions(-)

diff --git a/3rdparty/CMakeLists.txt b/3rdparty/CMakeLists.txt
index b25afb8..7ea417e 100644
--- a/3rdparty/CMakeLists.txt
+++ b/3rdparty/CMakeLists.txt
@@ -232,7 +232,7 @@ if(USE_SDL)
 endif()
 
 # OpenAL
-if (NOT ANDROID)
+if (NOT ANDROID AND NOT RPCS3_UWP)
 	add_subdirectory(OpenAL EXCLUDE_FROM_ALL)
 else()
 	add_library(3rdparty_openal INTERFACE)
diff --git a/CMakeLists.txt b/CMakeLists.txt
index 179e835..bf283f8 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -65,6 +65,22 @@ option(BUILD_RPCS3_TESTS "Build RPCS3 unit tests." OFF)
 option(RUN_RPCS3_TESTS "Run RPCS3 unit tests. Requires BUILD_RPCS3_TESTS" OFF)
 option(USE_GAMEMODE "Choose whether to enable GameMode features or not." ON)
 option(BUNDLE_UDEV_RULES "Include udev rules on Linux/FreeBSD" OFF)
+option(RPCS3_UWP "Build only the emulator core for the XBXPS3 Xbox (UWP) frontend: no Qt GUI, no executable" OFF)
+
+if(RPCS3_UWP)
+    if(NOT WIN32 OR NOT MSVC)
+        message(FATAL_ERROR "RPCS3_UWP requires an MSVC Windows build")
+    endif()
+    # The Xbox frontend links the core into a UWP app, so desktop-only integrations are turned off.
+    set(USE_SDL OFF CACHE BOOL "" FORCE)
+    set(USE_FAUDIO OFF CACHE BOOL "" FORCE)
+    set(USE_DISCORD_RPC OFF CACHE BOOL "" FORCE)
+    set(USE_LIBEVDEV OFF CACHE BOOL "" FORCE)
+    set(USE_GAMEMODE OFF CACHE BOOL "" FORCE)
+    set(USE_NATIVE_INSTRUCTIONS OFF CACHE BOOL "" FORCE)
+    # There is no system Vulkan loader on Xbox: the frontend loads the driver itself through volk.
+    add_compile_definitions(RPCS3_UWP VK_NO_PROTOTYPES)
+endif()
 
 set(CMAKE_MODULE_PATH "${CMAKE_CURRENT_SOURCE_DIR}/buildfiles/cmake")
 
diff --git a/rpcs3/CMakeLists.txt b/rpcs3/CMakeLists.txt
index 852bf4f..464a6d9 100644
--- a/rpcs3/CMakeLists.txt
+++ b/rpcs3/CMakeLists.txt
@@ -23,7 +23,7 @@ if(UNIX AND NOT APPLE AND NOT ANDROID)
     endif()
 endif()
 
-if (NOT ANDROID)
+if (NOT ANDROID AND NOT RPCS3_UWP)
     # Qt
     # finds Qt libraries and setups custom commands for MOC and UIC
     # Must be done here because generated MOC and UIC targets cant
@@ -34,13 +34,13 @@ endif()
 # subdirectories
 add_subdirectory(Emu)
 
-if (NOT ANDROID)
+if (NOT ANDROID AND NOT RPCS3_UWP)
     add_subdirectory(rpcs3qt)
 endif()
 
 gen_git_version(${CMAKE_CURRENT_SOURCE_DIR})
 
-if (NOT ANDROID)
+if (NOT ANDROID AND NOT RPCS3_UWP)
     # Build rpcs3_lib
     add_library(rpcs3_lib STATIC)
 
